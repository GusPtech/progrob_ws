<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robx7">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robx7 urdf file -->
    <xacro:include filename="$(find robx7_description)/urdf/robx7.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="robx7.ros2_control.xacro" />


    <xacro:robx7_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
